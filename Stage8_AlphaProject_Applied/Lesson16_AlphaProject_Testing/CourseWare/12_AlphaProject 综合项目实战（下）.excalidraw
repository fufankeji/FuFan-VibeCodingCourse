    {
      "id": "9YbTfGd2PSuF5A5MgxIqN",
      "type": "text",
      "x": 3724.148153369904,
      "y": 25439.38073680413,
      "width": 791.099609375,
      "height": 1375,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
