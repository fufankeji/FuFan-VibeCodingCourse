      "roughness": 0,
      "opacity": 100,
      "angle": 0,
      "seed": 1475803005,
      "version": 617,
      "versionNonce": 566610397,
      "isDeleted": false,
      "groupIds": [
        "xBfIkB-qjnR9nEIhhIMyX",
        "HAVdLUWHonUKlWawkiTN_",
        "xaxb5KA_vJHD2KGTpQb-w"
