    {
      "id": "wziQjCBnDEgoMOBbKGBXG",
      "type": "text",
      "x": 3679.3953238335193,
      "y": 33516.313687531656,
      "width": 884.1398315429688,
      "height": 250,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
