# ─────────────────────────────────────────────
# AlphaProject · 凭证模板（cp .env.example .env 后填值）
# 真实 .env 已在 .gitignore，不要提交
# ─────────────────────────────────────────────

# ── 飞书 Lark App（F6 推送通道）───────────────
# 1) https://open.feishu.cn → 创建企业自建应用
# 2) 凭证与基础信息 → 拿到 App ID / App Secret
# 3) 权限管理 → 开通：im:message / im:chat / contact:user.id（详见 specs/002-feishu-push-channel/）
# 4) 版本管理 → 创建版本 → 发布上线
# 5) 在飞书添加 bot 到目标群 → 拿到 chat_id（参见 README §3.2）
LARK_APP_ID=cli_xxxxxxxxxxxxxxxx
LARK_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LARK_RECEIVE_ID=oc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LARK_RECEIVE_ID_TYPE=chat_id

# ── LLM 主备链（F3 异动解释 / F4 简报）─────────
# 主：推荐 DeepSeek 直连 或 OpenRouter aggregator
# 任一 openai-compatible base_url 都行（Qwen / Kimi / DeepSeek / OpenRouter）
LLM_PRIMARY_BASE_URL=https://api.deepseek.com/v1
LLM_PRIMARY_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LLM_PRIMARY_MODEL=deepseek-chat

# 备：触发条件 = 主超时 / 限频 / 5xx
LLM_BACKUP_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_BACKUP_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LLM_BACKUP_MODEL=qwen-plus

# 本地兜底（主备都 timeout 用）—— 装好 ollama + 拉好模型即可
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b

# 单日预算上限（元）；超额自动切 ollama，详见 PRD §7.8
LLM_DAILY_BUDGET=5

# ── 数据源（可选，留空走 akshare 免费通道）──────
# Tushare Pro 5000 积分捐 500 元/年，可补强财报 / 龙虎榜
# https://tushare.pro
TUSHARE_TOKEN=

# ── 运行参数 ─────────────────────────────────
TZ=Asia/Shanghai
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=5173
BACKEND_PORT=8000
DB_PATH=./backend/alpha.db
