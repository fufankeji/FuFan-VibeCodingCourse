    {
      "id": "ens0FtP41HLyuYyCo3AKi",
      "type": "text",
      "x": 4598.402546107264,
      "y": 26598.83749559047,
      "width": 715.4596557617188,
      "height": 300,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
