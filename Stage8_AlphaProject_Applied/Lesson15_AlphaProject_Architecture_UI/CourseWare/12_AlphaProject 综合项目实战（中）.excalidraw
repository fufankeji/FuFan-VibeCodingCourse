    {
      "id": "Gjpd14h_TUJNiMqslIbh3",
      "type": "text",
      "x": 3629.5910547953613,
      "y": 22960.08313281382,
      "width": 808.119873046875,
      "height": 1075,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
